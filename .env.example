# Copy to .env. Never commit the real .env.
PORT=5173

# npm start listens locally by default. Compose overrides HOST inside the container.
HOST=127.0.0.1

# Published Docker port: change to 0.0.0.0 to allow access from other machines.
BIND_ADDRESS=127.0.0.1

# Yandex AI Studio. Both credentials enable live AI; empty values keep demo mode.
# Keep the real values on the server only.
YANDEX_API_KEY=''
YANDEX_FOLDER_ID=''

# Model names within the folder, not complete gpt:// URIs.
YANDEX_STORY_MODEL=aliceai-llm
YANDEX_QUESTION_MODEL=aliceai-llm-flash
YANDEX_VISION_MODEL=qwen3.6-35b-a3b

# Global paid-call limit for this process (including failed provider calls).
# Counters and story cache reset on restart; this is not a currency budget.
AI_REQUESTS_PER_HOUR=120
AI_TIMEOUT_MS=60000

# SpeechKit defaults to the existing Yandex key. Optional separate key:
# YANDEX_TTS_API_KEY=''
# Requires ai.speechkit-tts.user and key scope yc.ai.speechkitTts.execute.
YANDEX_TTS_ENABLED=true
YANDEX_TTS_VOICE=filipp
# Separate from the AI call limit. Failed synthesis calls also count.
TTS_REQUESTS_PER_HOUR=120

# Browser language chooses a matching voice. Legacy YANDEX_TTS_VOICE remains RU-only.
# YANDEX_TTS_VOICE_RU=filipp
YANDEX_TTS_VOICE_EN=john
