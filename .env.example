# Copy to .env. Never commit the real .env.
PORT=5173

# npm start listens locally by default. Compose overrides HOST inside the container.
HOST=127.0.0.1

# Published Docker port: change to 0.0.0.0 to allow access from other machines.
BIND_ADDRESS=127.0.0.1

# Optional server-side credentials for a future AI provider adapter.
# They are loaded into the process but do NOT enable AI in the current demo.
# Keep values containing $ or # in single quotes with ordinary Compose env_file.
# OPENAI_API_KEY=''
# OPENAI_MODEL=''
