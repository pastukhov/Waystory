# Copy to .env. Never commit the real .env.
PORT=5173

# npm start listens locally by default. Compose overrides HOST inside the container.
HOST=127.0.0.1

# Published Docker port: change to 0.0.0.0 to allow access from other machines.
BIND_ADDRESS=127.0.0.1

# Yandex AI Studio. Both credentials enable live AI; empty values keep demo mode.
# Keep the real values on the server only.
YANDEX_API_KEY=''
YANDEX_FOLDER_ID=''

# Model names within the folder, not complete gpt:// URIs.
YANDEX_STORY_MODEL=aliceai-llm
YANDEX_QUESTION_MODEL=aliceai-llm-flash
YANDEX_VISION_MODEL=qwen3.6-35b-a3b

# Global paid-call limit for this process (including failed provider calls).
# Counters and story cache reset on restart; this is not a currency budget.
AI_REQUESTS_PER_HOUR=120
AI_TIMEOUT_MS=60000

# SpeechKit defaults to the existing Yandex key. Optional separate key:
# YANDEX_TTS_API_KEY=''
# Requires ai.speechkit-tts.user and key scope yc.ai.speechkitTts.execute.
YANDEX_TTS_ENABLED=true
YANDEX_TTS_VOICE=filipp
# Separate from the AI call limit. Failed synthesis calls also count.
TTS_REQUESTS_PER_HOUR=120

# Browser language chooses a matching voice. Legacy YANDEX_TTS_VOICE remains RU-only.
# YANDEX_TTS_VOICE_RU=filipp
YANDEX_TTS_VOICE_EN=john

# Google login is required for ALL paid endpoints. Missing settings fail closed.
APP_ORIGIN=https://ws.nayg.ru
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact verified email addresses, comma-separated. Empty means nobody is invited.
GOOGLE_ALLOWED_EMAILS=
# SQLite path inside the persistent Docker volume. For local Node: data/waystory.sqlite.
AUTH_DB_PATH=/app/data/waystory.sqlite
# UTC-day API request quotas, including failed requests and cache hits; not rubles.
AI_USER_REQUESTS_PER_DAY=30
TTS_USER_REQUESTS_PER_DAY=100
AI_REQUESTS_PER_DAY=300
TTS_REQUESTS_PER_DAY=1000

# Default true: invited authenticated users have no daily/hourly count ceilings.
# false restores all configured user/global daily and provider hourly quotas.
# Authentication, concurrency, timeouts and input size limits always remain active.
AUTHENTICATED_REQUESTS_UNLIMITED=true

# Open-source place catalog (separate from OAuth). Feature staged off until rollout.
MULTISOURCE_ENABLED=true
SOURCE_DB_PATH=/app/data/sources.sqlite
OSM_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Paid search requires exact domain policies with verified compatible reuse rights.
WEB_ENRICHMENT_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_MAX_CALLS_PER_DAY=0


# Global selected-place search (one operator setup for all countries).
# Keep off until the provider key, call budget and reviewed content-use terms exist.
GLOBAL_SOURCE_DISCOVERY_ENABLED=false
# JSON: reviewed, termsUrl, reviewedAt (YYYY-MM-DD), allowModelInput,
# allowGeneratedAudio, allowGeneratedTextCache, allowTextCache, ttlMs.
# No default permissions are assumed from a search subscription.
GLOBAL_WEB_USE_POLICY_JSON=
